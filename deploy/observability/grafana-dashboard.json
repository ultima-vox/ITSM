{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "title": "Availability",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"vox-itsm\"})", "refId": "A" }]
    },
    {
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"vox-itsm\"}[5m]))", "refId": "A" }]
    },
    {
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"vox-itsm\"}[5m])))", "refId": "A" }]
    },
    {
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"vox-itsm\",status=~\"5..\"}[5m]))", "refId": "A" }]
    },
    {
      "title": "JVM heap utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{job=\"vox-itsm\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"vox-itsm\",area=\"heap\"}), 1)", "refId": "A" }]
    },
    {
      "title": "Database pool utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "sum(hikaricp_connections_active{job=\"vox-itsm\"}) / clamp_min(sum(hikaricp_connections_max{job=\"vox-itsm\"}), 1)", "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["vox-itsm", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Vox ITSM Production",
  "uid": "vox-itsm-production",
  "version": 1
}
