{
  "name": "vox-itsm-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:check": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "api:generate": "openapi-typescript openapi/itsm.json -o src/api/generated/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated/schema.d.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "openapi-fetch": "^0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.46.3",
    "vite": "8.2.1"
  }
}
