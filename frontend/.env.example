# Mock data is the default. Set to false to hit the real backend via Vite proxy.
VITE_USE_MOCK=true

# API base path (proxied to http://localhost:8080 in dev).
VITE_API_BASE=/api/v1

# Optional Bearer token (also readable from localStorage key `vox-api-token`).
# Not required when backend runs with Spring profile `dev` (open API as dev-local).
# Prefer Keycloak SPA login (OIDC) instead of pasting tokens here.
VITE_API_TOKEN=

# Optional actor subject for "assign to me" (localStorage `vox-user-id` overrides).
# VITE_API_ACTOR=dev-local

# ── Keycloak OIDC (Authorization Code + PKCE) ─────────────────────────────
# Set VITE_OIDC_ENABLED=true to show Sign in / Sign out and soft banner in live mode.
# Client `itsm-spa` is public; realm import: infra/keycloak/itsm-realm.json
VITE_OIDC_ENABLED=false
VITE_OIDC_ISSUER=http://localhost:8081/realms/itsm
VITE_OIDC_CLIENT_ID=itsm-spa
# Defaults to window.location.origin + /auth/callback when unset
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
