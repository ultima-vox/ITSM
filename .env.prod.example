# Production-shaped Compose stack — copy to .env and replace every value.
#   cp .env.prod.example .env
#   ./scripts/gen-tls-cert.sh                 # or point ITSM_TLS_DIR at your own certificates
#   docker compose -f docker-compose.prod.yml up -d --build
#
# SPRING_PROFILES_ACTIVE=prod refuses to start unless the issuer is https, the CORS
# origins are explicit https URLs, and none of the secrets below are left at demo values.

SPRING_PROFILES_ACTIVE=prod,compose

# Public hostnames served by the TLS edge.
ITSM_PUBLIC_URL=https://itsm.test
ITSM_KEYCLOAK_PUBLIC_URL=https://id.itsm.test:9443
ITSM_CORS_ORIGINS=https://itsm.test

OIDC_ISSUER_URI=https://id.itsm.test:9443/realms/itsm
VITE_OIDC_ISSUER=https://id.itsm.test:9443/realms/itsm
VITE_OIDC_REDIRECT_URI=https://itsm.test/auth/callback

# TLS material mounted into the edge (edge.crt / edge.key).
ITSM_TLS_DIR=./certs
ITSM_HTTPS_PORT=443
ITSM_ID_HTTPS_PORT=9443

# Secrets — generate per environment, never reuse these strings.
DB_PASSWORD=change-me-database
KC_DB_PASSWORD=change-me-keycloak-database
KC_ADMIN_USER=change-me-admin
KC_ADMIN_PASSWORD=change-me-admin-password
RABBITMQ_USER=change-me-broker
RABBITMQ_PASSWORD=change-me-broker-password
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
