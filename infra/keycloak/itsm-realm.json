        "composite": false,
        "clientRole": false
      },
      {
        "name": "SERVICE_DESK_MANAGER",
        "description": "Manages service desk operations",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "REQUESTER",
        "description": "End-user who submits requests",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CHANGE_MANAGER",
        "description": "Owns the change process",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CAB_MEMBER",
        "description": "Change advisory board member",
        "composite": false,
        "clientRole": false
      }
    ]
  },
